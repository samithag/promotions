# SQLAlchemy URL. Defaults to a local SQLite file; docker compose uses Postgres.
# DATABASE_URL=postgresql+psycopg://promotions:promotions@localhost:5432/promotions

# Minutes between scrapes of each bank.
# SCRAPE_INTERVAL_MINUTES=60

# Enables POST /api/v1/scrape-runs (send it in the X-Admin-Token header).
# ADMIN_TOKEN=change-me
